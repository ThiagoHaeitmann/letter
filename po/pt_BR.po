msgstr "URI da última pasta usada para salvar anexos."

#: data/io.github.stalvatero.Letter.gschema.xml.in:161
#: data/io.github.stalvatero.Mail.gschema.xml.in:134
msgid "Legacy compose signatures"
msgstr "Assinaturas de redação legadas"

#: data/io.github.stalvatero.Letter.gschema.xml.in:162
#: data/io.github.stalvatero.Mail.gschema.xml.in:135
msgid ""
"Old global signatures. Copied into per-account signatures once, then unused."
msgstr ""
"Assinaturas globais antigas. Copiadas uma única vez para as assinaturas por "
"conta e não utilizadas depois disso."

#: data/io.github.stalvatero.Letter.gschema.xml.in:166
#: data/io.github.stalvatero.Mail.gschema.xml.in:139
